# ==============================================================================
# SMASHHUB ENVIRONMENT CONFIGURATION TEMPLATE
# Copy file này thành .env hoặc .env.properties ở thư mục gốc dự án
# ==============================================================================

# Database MySQL
DB_URL=jdbc:mysql://localhost:3306/badminton_shop
DB_USERNAME=root
DB_PASSWORD=root

# Redis Cache & Distributed Lock
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=root

# JWT Signer Key (tối thiểu 32 ký tự)
JWT_SIGNER_KEY=your_super_secret_jwt_key_at_least_32_characters_long_123456

# Google OAuth2 (nếu dùng đăng nhập Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mail SMTP (Gmail App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Cloudinary (Upload ảnh sản phẩm, banner)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=smashhub

# ==============================================================================
# GIAO HÀNG NHANH (GHN) SANDBOX
# Đăng ký tài khoản test tại: https://5sao.ghn.dev/
# Lấy Token và Shop ID trong phần Quản lý thông tin tài khoản / Cửa hàng
# ==============================================================================
GHN_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=your_ghn_sandbox_token
GHN_SHOP_ID=your_ghn_shop_id
# Địa chỉ kho xuất hàng mặc định của shop (Ví dụ: Quận 1, TP.HCM)
GHN_FROM_DISTRICT_ID=1442
GHN_FROM_WARD_CODE=20101
# Token xác thực khi GHN bắn Webhook cập nhật trạng thái đơn (tự đặt bí mật)
GHN_WEBHOOK_TOKEN=smashhub_ghn_webhook_secret_token

# ==============================================================================
# VNPAY SANDBOX
# Đăng ký sandbox tại: https://sandbox.vnpayment.vn/devreg/
# Sau khi đăng ký, VNPay sẽ gửi TMN Code và Hash Secret qua email
# ==============================================================================
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret_key
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# URL giao diện Frontend nhận kết quả sau khi khách thanh toán xong trên VNPay
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay/return
VNPAY_EXPIRE_MINUTES=15


# ==============================================================================
# GOOGLE GEMINI AI CONFIGURATION
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
AI_ENABLED=true
